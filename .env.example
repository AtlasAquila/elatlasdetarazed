# Variables de entorno. En Vercel: Project → Settings → Environment Variables.
# En tu ordenador: copia este archivo como .env.local.

# Supabase (proyecto atlas-aquila, región París). Estas dos son públicas.
NEXT_PUBLIC_SUPABASE_URL=https://ejkxvnwsglzxkhrkuwkd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_lg6vIFxtgBahAwzjvZlKLg_-tTmmruw

# Solo en el servidor. Se usa para borrar cuentas (RGPD). Nunca la compartas ni la pegues en el chat.
# Supabase → Project Settings → API Keys → secret / service_role
SUPABASE_SERVICE_ROLE_KEY=

# Dirección pública de la web (sin barra final)
NEXT_PUBLIC_SITE_URL=https://elatlasdetarazed.com

# Web privada durante el desarrollo: con una contraseña aquí, el navegador la pedirá
# (usuario: cualquiera). Déjalo vacío para abrir la web al público.
SITE_PASSWORD=

# Pon "true" solo cuando lances la web, para que Google pueda indexarla.
NEXT_PUBLIC_SITE_PUBLIC=false
